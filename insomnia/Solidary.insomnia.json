    {
      "_id": "req_login_admin",
      "_type": "request",
      "parentId": "fld_auth",
      "modified": 0,
      "created": 0,
      "name": "Login as Admin",
      "description": "Public. Logs in with the seeded Admin account and stores the JWT into the 'adminToken' environment variable — every Admin-only request below reads that variable automatically, so you only need to run this once per session (tokens expire after Jwt:ExpirationMinutes, default 60 min — just re-run this request when one expires).",
      "url": "{{ _.baseUrl }}/auth/login",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.adminEmail }}\",\n  \"password\": \"{{ _.adminPassword }}\"\n}"
      },
      "parameters": [],
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "authentication": { "type": "none" },
      "afterResponseScript": "const body = insomnia.response.json();\nif (body && body.token) {\n  insomnia.environment.set('adminToken', body.token);\n}",
      "metaSortKey": -300,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
