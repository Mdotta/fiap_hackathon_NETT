      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"fullName\": \"{{ _.donorFullName }}\",\n  \"email\": \"{{ _.donorEmail }}\",\n  \"cpf\": \"{{ _.donorCpf }}\",\n  \"password\": \"{{ _.donorPassword }}\"\n}"
